#!/data/data/com.termux/files/usr/bin/bash
# i-Haklab PNPM Wrapper (Bash version)

source ${HOME}/.local/etc/i-Haklab/functions

if [[ "$1" == "install" || "$1" == "update" ]]; then
    pushd "$HOME" >/dev/null
    for i in "${@:2}"; do
        i=$(ih_normalize_pkg "$i")

        case "$i" in 
            @fission-ai/openspec)
                echo "> Setting allow-scripts for @fission-ai/openspec"
                npm config set allow-scripts=@fission-ai/openspec --location=user
                ;;
            n8n)
                bash "$HOME/.local/libexec/preconf" n8n pnpm
                ;;
            
            open-lovable)
                bash "$HOME/.local/libexec/preconf" open-lovable pnpm "$1"
                break
                ;;
            
            -g|--global)
                g="$i"
                ;;
        esac

        "$PREFIX/bin/pnpm" "$1" "$g" "$i"
        ih_pkg2conf "$i"
    done
    popd >/dev/null 2>/dev/null

elif [[ "$1" == "uninstall" ]]; then
    pushd "$HOME" >/dev/null
    for i in "${@:2}"; do
        case "$i" in
            -g|--global)
                g="$i"
                ;;
            *)
                bash "$HOME/.local/libexec/cleanup" "$i"
                ;;
        esac
        "$PREFIX/bin/pnpm" "$1" "$g" "$i"
    done
    popd >/dev/null 2>/dev/null
else
    "$PREFIX/bin/pnpm" "$@"
fi
