#!/data/data/com.termux/files/usr/bin/bash
# i-Haklab AI Wrapper (Bash version)
# AI assistant: natural language -> terminal command (local ollama / groq cloud)

source ${HOME}/.local/etc/i-Haklab/functions

# GROQ_API_KEY: uses the key stored via `i-Haklab setapikey` (groq -> APIKEY_groq)
if [[ -z "$GROQ_API_KEY" ]]; then
    export GROQ_API_KEY="$(grep '^export APIKEY_groq=' "$HOME/.local/etc/i-Haklab/variables" 2>/dev/null | head -1 | cut -d'"' -f2)"
fi

VENDOR="$HOME/.local/libexec/iH-ai-shell.py"
MODEL="qwen2.5-coder:1.5b"

IHK_CTX="i-Haklab context (Termux-based suite): main command 'i-Haklab <sub>' with subcommands help, about <tool>, show alltools, setapikey, setbanner, setshell, setuser, chatAI, backup, aptup, ngroklink, ngrokssh, tunnel, servers4test, Xwayland. Wrappers in ~/.local/bin replacing standard commands: apt/npm/pnpm (install tools), bat (cat), nls (ls), glow (md), df, du, proxy (tor), pm, cmd, fixer, rmcache. To install a tool: apt install <tool>. Docs: i-Haklab about <tool>. Menu: i-Haklab help."

if [[ "$1" == "disable" ]]; then
    bash "$HOME/.local/libexec/cleanup" ai
    exit 0
fi

if [[ "$1" == "-v" || "$1" == "--voice" ]]; then
    shift
fi

prompt=("$@")
no_run=false
filtered=()
for a in "${prompt[@]}"; do
    [[ "$a" == "--no-run" ]] && { no_run=true; continue; }
    filtered+=("$a")
done
prompt=("${filtered[@]}")

if [[ ${#prompt[@]} -eq 0 ]]; then
    chk-pkg termux-dialog termux-api
    echo "(_>) Speak now ..."
    text=$(termux-dialog speech 2>/dev/null | jq -r '.text' 2>/dev/null)
    if [[ -z "$text" || "$text" == "null" ]]; then
        echo "(_>) The 'Termux:API' app (termux-api.apk) with microphone permission is required."
        exit 1
    fi
    prompt=("$text")
fi

if [[ ! -f "$VENDOR" ]]; then
    bash "$HOME/.local/libexec/preconf" ai
    [[ -f "$VENDOR" ]] || { echo "(_>) Missing vendored backend iH-ai-shell.py"; exit 1; }
fi

PYBIN="$VENDOR"

# Non-AI commands (help/history) need neither ollama nor a model.
case "${prompt[0]}" in
    --help|-h|--history|-H|--clear-history)
        exec python3 "$PYBIN" "${prompt[@]}"
        ;;
esac

if ! curl -s --max-time 2 http://127.0.0.1:11434/api/tags >/dev/null 2>&1; then
    command -v ollama >/dev/null || { echo "(_>) ollama is not installed"; exit 1; }
    echo "(_>) Starting ollama server ..."
    nohup ollama serve >/dev/null 2>&1 &
    for _ in $(seq 1 15); do
        curl -s --max-time 1 http://127.0.0.1:11434/api/tags >/dev/null 2>&1 && break
        sleep 1
    done
fi

if ! ollama list 2>/dev/null | grep -q "$MODEL"; then
    echo "(_>) Pulling $MODEL ..."
    ollama pull "$MODEL"
fi

joined=$(printf '%s' "${prompt[*]}")
if printf '%s' "$joined" | grep -Eiq 'i-haklab|ihaklab|setapikey|helpper|alltools|wrapper|documentacion|apikey|clave de|groq'; then
    prompt=("$IHK_CTX $joined")
fi

args=()
for a in "${prompt[@]}"; do
    args+=("$a")
done

has_model=false
for a in "${args[@]}"; do
    [[ "$a" == "-m" || "$a" == "--model" ]] && has_model=true
done
[[ "$has_model" == false ]] && args+=(--model "$MODEL")
[[ "$no_run" == false ]] && args+=(--run)

exec python3 "$PYBIN" "${args[@]}"
