#!/data/data/com.termux/files/usr/bin/bash
# i-Haklab APT Wrapper (Bash version)

source ${HOME}/.local/etc/i-Haklab/variables
source ${HOME}/.local/etc/i-Haklab/functions

search_wrapper() {
        echo -en "(_>) $1 is a tool added by i-Haklab\n[💡] Run 'i-Haklab about $1' for the tool manual\n"
}

install_wrapper() {
    local method="$1"
    local pkg="$2"
    local type="$3"
    toolName="$4"

    [[ "$pkg" == "ctx7" ]] && { pkg="ctx7 setup";}

    echo -en "${R}E:${W} $toolName is a $type, you should try it with ${Y}'$method $pkg'${W}\n"
    echo "(_>) you want me to run it for you? "
    while true; do
        read -p "(y/n): " yesornot
        case "$yesornot" in
            y|Y|yes|YES)
                local -a _cmd
                read -ra _cmd <<< "$method $pkg"
                "${_cmd[@]}"
                # npm wrapper already runs ih_pkg2conf; skip to avoid double run
                [[ "$method" == npm* ]] || ih_pkg2conf "${toolName:-$pkg}"
                break
                ;;

            n|N|no|NO)
                echo "Aborting ..."
                break
                ;;
            *)
                echo "Please answer y or n."
                ;;
        esac
    done
}

# Main logic
if [[ "$1" == "install" || "$1" == "reinstall" || "$1" == "search" ]]; then
    for i in "${@:2}"; do
        case "$i" in
            # PYTHON MODULES
            bloodhound|frida|h8mail|hashid|holehe|mvt|objection|octosuite|orbitaldump|osrframework|phoneintel|scrapy|shodan|snscrape|speedtest-cli|sqlmap|wfuzz)
                [[ "$1" == "search" ]] && { search_wrapper  "$i"; continue;}
                install_wrapper "python3 -m pip install" "$i" "python module"
                continue
                ;;

            # RUBY GEMS
            bettercap|aquatone)
                [[ "$1" == "search" ]] && { search_wrapper  "$i"; continue;}
                install_wrapper "gem install" "$i" "ruby gem"
                continue
                ;;

            # NPM MODULES
            bash-obfuscate|codex|copilot-cli|gemini-cli|kimi-code|localtunnel|minimax-cli|n8n|pnpm|open-lovable|openspec|sleepwalker|qwen-code|testsprite|twifo-cli|zcode-cli)
                [[ "$1" == "search" ]] && { search_wrapper  "$i"; continue;}
                toolName="$i"
                i=$(ih_normalize_pkg "$i")
                install_wrapper "npm install -g" "$i" "nodejs module" "$toolName"
                continue
                ;;
            # NPX MODULES
            context7|sleepwalkerai)
                [[ "$1" == "search" ]] && { search_wrapper  "$i"; continue;}
                toolName="$i"
                i=$(ih_normalize_pkg "$i")
                install_wrapper "npx" "$i" "npx module" "$toolName"
                continue
                ;;

            comandle)
                [[ "$1" == "search" ]] && { search_wrapper  "$i"; continue;}
                toolName="$i"
                i=$(ih_normalize_pkg "$i")
                install_wrapper "go install" "$i" "go binary" "$toolName"
                continue
                ;;

            clmystery)
                [[ "$1" == "search" ]] && { search_wrapper  "$i"; continue;}
                if [[ ! -d "$HOME/.local/share/$i" ]]; then
                    echo "Installing $i ..."
                    if git clone --quiet "https://github.com/veltman/clmystery" "$HOME/.local/share/$i"; then
                        echo "$i: english version installed in: ~/.local/share/$i"
                    else
                        echo -en "${Y}W:${W} Download english version failed\n"
                    fi
                else
                    echo "$i is already installed (english version)"
                fi
                if [[ ! -d "$HOME/.local/share/${i}_esp" ]]; then
                    rm -f "$TMPDIR/CTF_CLImurder.zip" 2>/dev/null
                    megadl "https://mega.nz/file/aDJ0DJzS#j_7MUsVpjRmbsVjtKObTFeHjxKmV_2knXhfcvHG_4sA" --path "$TMPDIR/" 2>>"$LOGFILE"
                    if unzip "$TMPDIR/CTF_CLImurder.zip" -d "$HOME/.local/share/" ; then
                        echo "$i: version en español instalada en: ~/.local/share/${i}_esp"
                        rm -f "$TMPDIR/CTF_CLImurder.zip" 2>>"$LOGFILE"
                    else
                        echo -en "${Y}W:${W} Download spanish version failed\n"
                    fi
                else
                    echo "$i is already installed (spanish version)"
                fi
                continue
                ;;

            # OH MY FISH PLUG-IN
            omf)
                if command -v fish >/dev/null; then
                    echo "Installing oh-my-fish over fish shell ..."
                    curl -fsSL "https://raw.githubusercontent.com/ivam3/i-Haklab/master/.deb/home/.local/etc/i-Haklab/get.oh-my.fish" -o "$TMPDIR/omf.fish"
                    fish "$TMPDIR/omf.fish"
                    rm "$TMPDIR/omf.fish"
                else
                    echo -en "${R}E:${W} Fish needed, you should try it with ${Y}'apt install fish'${RESET}\n"
                fi
                continue
                ;;

            *)
                "$PREFIX/bin/apt" "$1" "$i"
                [[ "$1" == "search" ]] || { ih_pkg2conf "$i";}
                ;;
        esac
    done
elif [[ "$1" == "remove" || "$1" == "purge" || "$1" == "uninstall" ]]; then
    for i in "${@:2}"; do
        [[ "$i" == -* ]] || bash "$HOME/.local/libexec/cleanup" "$i"
    done
    "$PREFIX/bin/apt" "$@"
else
    "$PREFIX/bin/apt" "$@"
fi
