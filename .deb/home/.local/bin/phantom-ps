#!/data/data/com.termux/files/usr/bin/bash
# i-Haklab phantom-ps — phantom processes limit manager (Android 12+)
# Usage: phantom-ps [--set <0-2147483647>] [--always] [--restore] [--help]
#   no args: if limit !=32 (32b), set to 2147483647 (INT_MAX, disable killer)
#   --set <val>: set to custom value (0-2147483647) via ADB, pair if needed
#   --always: make persistent (device_config set_sync_disabled_for_tests persistent) + whitelist + appops, can be combined with --set
#   --restore: restore defaults per Android version (API via getprop), remove persistent and Termux background tweaks

set -euo pipefail
# i-Haklab colors/banner - nounset-safe (functions uses $1 without default)
set +u
source "${HOME}/.local/etc/i-Haklab/variables"
# shellcheck disable=SC1090,SC2154
source "${iHETC:-$HOME/.local/etc/i-Haklab}/functions"
# Convert \e to real escape for direct use of ${C} in messages
for _c in R G Y B M C W bold dim gray darkgray; do
  # shellcheck disable=SC2154
  eval "_v=\${$_c:-}"; [[ -n "$_v" ]] && printf -v "$_c" '%b' "$_v" 2>/dev/null || true
done
# alias for functions
export GREEN="$G" RED="$R" YELLOW="$Y" CYAN="$C" BLUE="$B" MAGENTA="$M" WHITE="$W" RESET="$W" DIM="$dim" GREY="$gray" 2>/dev/null || true
export GREY="${gray:-}" CYAN_LIGHT="$C" 2>/dev/null || true
set -u

# --- helpers ---
usage() {
  cat <<'USAGE'
Usage: phantom-ps [--set <value>] [--always] [--restore] [--help]
  no args          validate current limit; if !=32 (32b), set to 2147483647 via ADB
  --set <val>      set max_phantom_processes to <val> (0-2147483647), e.g. --set 32 or --set 65536
  --always         make last set persistent (set_sync_disabled_for_tests persistent + whitelist + appops)
                   can be combined: phantom-ps --set 2147483647 --always | phantom-ps --always (=2147483647 persistent, from 4ever.sh)
  --restore        restore defaults per Android version (via getprop ro.build.version.sdk / env) and remove persistent tweaks
  --help, -h       show this help
Examples:
  phantom-ps
  phantom-ps --set 32
  phantom-ps --set 65536 --always
  phantom-ps --always
  phantom-ps --restore
USAGE
}

banner
# --- parse args ---
SET_VAL=""
ALWAYS=0
RESTORE=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --set)
      if [[ -z "${2:-}" ]]; then err " --set requires a value" >&2; usage; exit 1; fi
      SET_VAL="$2"; shift 2
      ;;
    --always) ALWAYS=1; shift ;;
    --restore) RESTORE=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) err "unknown arg: $1" >&2; usage; exit 1 ;;
  esac
done

# validate --set
if [[ -n "$SET_VAL" ]]; then
  if ! [[ "$SET_VAL" =~ ^[0-9]+$ ]]; then err " --set value must be integer 0-2147483647, got '$SET_VAL'" >&2; exit 1; fi
  if (( SET_VAL < 0 || SET_VAL > 2147483647 )); then err " --set out of range 0-2147483647" >&2; exit 1; fi
fi

# --- get current limit ---
phantom_limit=$(/system/bin/dumpsys activity settings 2>/dev/null | grep max_phantom_processes | awk -F "=" '{print $NF}' | tr -d ' \r' || echo "")
# fallback via device_config / settings
if [[ -z "$phantom_limit" ]]; then
  phantom_limit=$(adb shell "device_config get activity_manager max_phantom_processes" 2>/dev/null | tr -d '\r ' || echo "")
fi
if [[ -z "$phantom_limit" ]]; then phantom_limit="unknown"; fi

# --- --restore mode ---
if (( RESTORE == 1 )); then
  # determine default per Android version via env/getprop
  API=$(getprop ro.build.version.sdk 2>/dev/null | tr -d ' \r' || echo "")
  if [[ -z "$API" ]]; then API=$(dumpsys activity settings 2>/dev/null | grep -o 'sdk=[0-9]*' | cut -d= -f2 | head -n1 || echo "32"); fi
  # defaults: <31 no phantom, 31+ =32 (AOSP), OEM may have 32; use 32 as safe restore per user request
  DEFAULT=32
  # allow API-specific override if ro.config.* exists
  PROP_MAX=$(getprop ro.config.max_phantom_processes 2>/dev/null | tr -d ' \r' || echo "")
  if [[ "$PROP_MAX" =~ ^[0-9]+$ ]]; then DEFAULT="$PROP_MAX"; fi

  info "Restoring defaults for API ${Y}$API${W} -> max_phantom_processes=${G}$DEFAULT${W}"

  # need ADB connection
  IP=$(LOCALHOST 2>/dev/null || echo "127.0.0.1")
  # try existing adb devices first
  DEVS=$(adb devices 2>&1 | awk 'NR>1 && $2=="device" {print $1}' || true)
  if [[ -z "$DEVS" ]]; then
    warn "No adb device, attempting pair/connect..."
    PAIR_PORT=""; while [[ -z "$PAIR_PORT" ]]; do read -p "$(printf "${Y}(>_) Pairing port: ${W}")" PAIR_PORT; done
    PAIR_CODE=""; while [[ -z "$PAIR_CODE" ]]; do read -p "$(printf "${Y}(>_) Pairing code: ${W}")" PAIR_CODE; done
    OUT=$(adb pair "$IP:$PAIR_PORT" "$PAIR_CODE" 2>&1); msg "$OUT"
    msg "searching for debug port ..."
    LPORTS=$(nmap -sT -p 10000-65535 --open -T4 -oG - "$IP" 2>/dev/null | grep "Ports:" | grep -oP '\d{5}(?=/open/tcp)' | sort -u || true)
    for p in $LPORTS; do OUT=$(adb connect "$IP:$p" 2>&1); [[ "$OUT" == *"connected to"* ]] && ok "connected to ${C}$IP:$p${W}" && break; done
    DEVS=$(adb devices 2>&1 | awk 'NR>1 && $2=="device" {print $1}' || true)
  fi
  # pick first device
  SERIAL=$(echo "$DEVS" | head -n1)
  if [[ -n "$SERIAL" ]]; then ADB="adb -s $SERIAL"; else ADB="adb"; fi

  # restore phantom
  $ADB shell "device_config put activity_manager max_phantom_processes $DEFAULT" 2>&1 | while read -r l; do msg "$l"; done
  $ADB shell "device_config set_sync_disabled_for_tests none" 2>&1 | while read -r l; do msg "$l"; done
  $ADB shell "settings put global max_phantom_processes $DEFAULT" 2>/dev/null || true
  # restore Termux background
  $ADB shell "dumpsys deviceidle whitelist -com.termux" 2>&1 | while read -r l; do msg "$l"; done
  $ADB shell "cmd appops set com.termux RUN_IN_BACKGROUND default" 2>&1 | while read -r l; do msg "$l"; done
  $ADB shell "cmd appops set com.termux WAKE_LOCK default" 2>&1 | while read -r l; do msg "$l"; done
  $ADB shell "am set-inactive com.termux true" 2>&1 | while read -r l; do msg "$l"; done

  phantom_limit=$(/system/bin/dumpsys activity settings 2>/dev/null | grep max_phantom_processes | awk -F "=" '{print $NF}' | tr -d ' \r' || echo "$DEFAULT")
  ok "Phantom processes limit: ${G}$phantom_limit${W} (restored to $DEFAULT for API $API)"
  exit 0
fi

# --- determine target for normal / --set / --always ---
TARGET=""
if [[ -n "$SET_VAL" ]]; then
  TARGET="$SET_VAL"
else
  # no --set: validate if !=32 (32b) -> set to 2147483647, else echo
  # consider "32" and "32b" as ok per user clarification
  if [[ "$phantom_limit" = "32" || "$phantom_limit" = "32b" ]]; then
    ok "Phantom processes limit: ${G}$phantom_limit${W} (ok, 32b secure default)"
    # if --always is also set without --set, still need to make persistent with 2147483647
    if (( ALWAYS == 1 )); then
      info "Applying ${Y}--always${W} persistent tweaks with ${G}2147483647${W}..."
      TARGET="2147483647"
    else
      exit 0
    fi
  else
    TARGET="2147483647"
  fi
fi

# if we have a target, need ADB
if [[ -n "$TARGET" ]]; then
  # check if already at target and not --always (no need to re-apply if not persistent)
  if [[ "$phantom_limit" = "$TARGET" && $ALWAYS -eq 0 ]]; then
    ok "Phantom processes limit: ${G}$phantom_limit${W} (already $TARGET)"
    exit 0
  fi

  # GETTING THE IP OF THE DEVICE
  IP=$(LOCALHOST 2>/dev/null || echo "127.0.0.1")
  info "IP: ${C}$IP${W} (target: ${Y}$TARGET${W})"

  # check if adb already connected
  DEVS=$(adb devices 2>&1 | awk 'NR>1 && $2=="device" {print $1}' || true)
  NEED_PAIR=1
  if echo "$DEVS" | grep -q .; then
    # already have device, try to use first
    NEED_PAIR=0
    # but if phantom_limit !=32, we still need to ensure we have a device to set
    # if no device, will pair
  fi

  if [[ "$phantom_limit" != "32" ]] || [[ -n "$SET_VAL" ]] || (( ALWAYS == 1 )); then
    # ensure pairing if needed (when no device or need_mig)
    if (( NEED_PAIR == 1 )) || ! echo "$DEVS" | grep -q .; then
      PAIR_PORT=""
      while [[ -z "$PAIR_PORT" ]]; do
        read -p "$(printf "${Y}(>_) Pairing port: ${W}")" PAIR_PORT
      done
      PAIR_CODE=""
      while [[ -z "$PAIR_CODE" ]]; do
        read -p "$(printf "${Y}(>_) Pairing code: ${W}")" PAIR_CODE
      done
      OUT=$(adb pair "$IP:$PAIR_PORT" "$PAIR_CODE" 2>&1)
      if [[ "$OUT" == *"Successfully paired to"* ]]; then
        ok "paired to ${C}$IP:$PAIR_PORT${W}"
      elif [[ "$OUT" == *"unable to"* ]]; then
        err "fail (${OUT})"
        exit 1
      else
        err "fail (unknown error)"
        exit 1
      fi
      msg "searching for debug port ..."
      LPORTS=$(nmap -sT -p 10000-65535 --open -T4 -oG - "$IP" 2>/dev/null | grep "Ports:" | grep -oP '\d{5}(?=/open/tcp)' | sort -u || true)
      for p in $LPORTS; do
        OUT=$(adb connect "$IP:$p" 2>&1)
        if [[ "$OUT" == *"connected to"* ]]; then
          ok "connected to ${C}$IP:$p${W}"
          break
        fi
        sleep 1
      done
    else
      # already connected, pick first device's port
      p=$(echo "$DEVS" | head -n1 | grep -oE '[0-9]+$' || echo "")
      if [[ -z "$p" ]]; then p=""; fi
    fi

    # Determine SERIAL for adb -s
    DEVS2=$(adb devices 2>&1 | awk 'NR>1 && $2=="device" {print $1}' || true)
    SERIAL2=$(echo "$DEVS2" | head -n1)
    if [[ -n "$SERIAL2" ]]; then
      ADB_S="adb -s $SERIAL2"
    elif [[ -n "${p:-}" ]]; then
      ADB_S="adb -s $IP:$p"
    else
      ADB_S="adb"
    fi

    # Granting permissions and setting the limit
    $ADB_S shell pm grant com.termux android.permission.PACKAGE_USAGE_STATS >/dev/null 2>&1 || true
    $ADB_S shell pm grant com.termux android.permission.DUMP >/dev/null 2>&1 || true
    # use device_config put
    $ADB_S shell "/system/bin/device_config put activity_manager max_phantom_processes $TARGET" 2>&1 | while read -r l; do msg "$l"; done
    # also try settings put for persistence check
    $ADB_S shell "settings put global max_phantom_processes $TARGET" 2>/dev/null || true

    if (( ALWAYS == 1 )); then
      info "Applying ${Y}--always${W} persistent tweaks..."
      $ADB_S shell "device_config set_sync_disabled_for_tests persistent" 2>&1 | while read -r l; do msg "$l"; done
      $ADB_S shell "dumpsys deviceidle whitelist +com.termux" 2>&1 | while read -r l; do msg "$l"; done
      $ADB_S shell "cmd appops set com.termux RUN_IN_BACKGROUND allow" 2>&1 | while read -r l; do msg "$l"; done
      $ADB_S shell "cmd appops set com.termux WAKE_LOCK allow" 2>&1 | while read -r l; do msg "$l"; done
      $ADB_S shell "am set-inactive com.termux false" 2>&1 | while read -r l; do msg "$l"; done
    fi

    phantom_limit=$(/system/bin/dumpsys activity settings 2>/dev/null | grep max_phantom_processes | awk -F "=" '{print $NF}' | tr -d ' \r' || echo "$TARGET")
  fi
fi

ok "Phantom processes limit: ${G}$phantom_limit${W}"
