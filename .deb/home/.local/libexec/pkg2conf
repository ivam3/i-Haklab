#!/data/data/com.termux/files/usr/bin/bash
IFS=$'\n\t'
trap ctrl_c 2

source ${HOME}/.local/etc/i-Haklab/variables
source $iHETC/functions

tput civis
echo -en "\rSetting $1 following i-Haklab instructions ...  \b"

case "$1" in 
    apache2|phpmyadmin)    
        USRapache="${PREFIX}/etc/apache2"
        HOMEapache="${HOME}/.local/etc/apache2"
		
        for i in apache2 phpmyadmin; do
			[[ -d ${HOME}/.local/etc/$i ]] || {
				mkdir -p ${HOME}/.local/etc/$i;
			}
		done

		[[ -e $HOMEapache/httpd.conf ]] || {
			curl -fsSL $iHDB/.local/etc/apache2/httpd.conf -o $HOMEapache/httpd.conf;
		}
		[[ -e $HOMEapache/php_module.conf ]] || {
			curl -fsSL $iHDB/.local/etc/apache2/php_module.conf -o $HOMEapacheE/php_module.conf;
		}
		[[ -e $USRapache/httpd.conf ]] && {
			rm -rf $USRapache/httpd.conf;
		}
		[[ -e ${PREFIX}/etc/phpmyadmin/config.inc.php ]] && {
			rm -rf ${PREFIX}/etc/phpmyadmin/config.inc.php;
		}
        curl -fsSL $iHDB/.local/etc/phpmyadmin/config.inc.php \
            -o ${HOME}/.local/etc/phpmyadmin/config.inc.php;
		ln -s $HOMEapache/httpd.conf $USRapache/httpd.conf 2>>$LOGFILE
        ln -s $HOMEapache/php_module $USRapache/conf.d/php_module.conf 2>>$LOGFILE
		ln -s ${HOME}/.local/etc/phpmyadmin/config.inc.php ${PREFIX}/etc/phpmyadmin/config.inc.php 2>>$LOGFILE
        ;; # --->  Nuevo comando 

    bash)
        [[ -e ${HOME}/.bashrc ]] && { mv ${HOME}/.bashrc ${HOME}/.bashrc.bak; }
        [[ -e ${HOME}/.local/etc/bash/bashrc ]] || { 
            curl -fsSL ${iHDB}/.local/etc/bash/bashrc -o ${HOME}/.local/etc/bash/bashrc;
        }
        ln -s ${HOME}/.local/etc/bash/bashrc ${HOME}/.bashrc
        ;;

    clamav)
        [[ -e ${PREFIX}/clamav/freshclam.conf.sample ]] && {
          mv ${PREFIX}/clamav/freshclam.conf.sample ${PREFIX}/clamav/freshclam.conf
        }
        freshclam 
        ;; # --->  Nuevo comando 

    fish)
        [[ -e ${PREFIX}/etc/fish/config.fish ]] && {
            rm -f ${PREFIX}/etc/fish/config.fish 2>>$LOGFILE
        }
        ln -s ${HOME}/.local/etc/fish/config.fish ${PREFIX}/etc/fish/config.fish 2>>$LOGFILE
        ;;

	gdb)
        [[ -d $TOOLS/peda ]] && { rm -rf $TOOLS/peda;}
		git clone --quiet https://github.com/longld/peda.git $TOOLS/peda
		[[ -e ${HOME}/.gdginit ]] || touch ${HOME}/.gdbinit
		echo "source $TOOLS/peda/peda.py" > ${HOME}/.gdbinit
		;; 
    gh)
        gh skill install cli/cli gh --scope user
        ;;

    @google/gemini-cli)
        indexFile="${PREFIX}/lib/node_modules/@google/gemini-cli/node_modules/clipboardy/index.js"
        let ln="$(grep -n "case 'android'" $indexFile | cut -d: -f1)+1"
        sed -i "${ln}s|===|!==|" $indexFile
        ;;
    
    @qwen-code/qwen-code|@anthropic-ai/claude-code)
        python3 -m pip --no-color --quiet --no-cache-dir install mistral-vibe 2>>$LOGFILE
        ;;

    @smithery/cli)
        indexFile="${PREFIX}/lib/node_modules/@smithery/cli/dist/index.js"
        # Fix: force platform "linux" on Android to avoid destructure error
        sed -i 's/Ohe=process.platform,{baseDir:/Ohe=process.platform==="android"?"linux":process.platform,{baseDir:/' "$indexFile"
        # Fix shebang for Termux
        termux-fix-shebang "$indexFile"
        echo "[💡] Authenticate to your Smithery account (flet-mcp-server)"
        echo " ╰─➤ smithery auth login"
        echo "[💡] Set it at your AI-agent running"
        echo " ╰─➤ smithery mcp add https://server.smithery.ai/nwokikeonyeka/flet-mcp-server --client agentAI'"
        echo "[📢] substitute 'agentAI' with your agent name"
        ;;

    @github/copilot)
        loaderFile="${PREFIX}/lib/node_modules/@github/copilot/npm-loader.js"
        # Fix 1: npm skips os=linux optionalDeps on android (EBADPLATFORM) -> force glibc arm64 matching the wrapper version
        if [[ -f "${PREFIX}/lib/node_modules/@github/copilot/package.json" ]]; then
            copilotVer="$(grep '"version"' "${PREFIX}/lib/node_modules/@github/copilot/package.json" | head -1 | cut -d'"' -f4)"
            platVer="$(grep '"version"' "${PREFIX}/lib/node_modules/@github/copilot-linux-arm64/package.json" 2>/dev/null | head -1 | cut -d'"' -f4)"
            if [[ -n "$copilotVer" ]] && { [[ "$platVer" != "$copilotVer" ]] || [[ ! -d "${PREFIX}/lib/node_modules/@github/copilot-linux-arm64" ]]; }; then
                "$PREFIX/bin/npm" install -g --force "@github/copilot-linux-arm64@${copilotVer}" >>"$LOGFILE" 2>&1
            fi
            # leftover musl build (177MB, requires missing /lib/ld-musl) -> remove
            [[ -d "${PREFIX}/lib/node_modules/@github/copilot-linuxmusl-arm64" ]] && \
                "$PREFIX/bin/npm" uninstall -g @github/copilot-linuxmusl-arm64 >>"$LOGFILE" 2>&1
        fi
        # Fix 2: android->linux + spawn via glibc loader without LD_PRELOAD + copilot.real (idempotent, with migration)
        # libtermux-exec declares NEEDED [libc.so] (Bionic style); if the glibc loader preloads it,
        # it resolves libc.so to the GNU ld text script -> "invalid ELF header". Stripped only
        # for the glibc process; Termux children of node keep their env untouched.
        # Note: .../copilot-linux-arm64/copilot is a bash wrapper (not ELF); ld.so must load copilot.real.
        if [[ -f "$loaderFile" ]] && { ! grep -q 'process.platform==="android")return\["linux"\]' "$loaderFile" || ! grep -q 'delete e\.LD_PRELOAD' "$loaderFile" || ! grep -q '\.real' "$loaderFile"; }; then
            cp -f "$loaderFile" "${loaderFile}.bak"
            python3 - "$loaderFile" <<'PY'
import sys
p = sys.argv[1]
s = open(p).read()
# ensure node:fs import for .real check
if 'existsSync as f' not in s:
    s = s.replace('from"detect-libc";', 'from"detect-libc";import{existsSync as f}from"node:fs";')
NEW_U = 'function u(r,t){if(process.platform==="android"){const e={...process.env};delete e.LD_PRELOAD;try{if(f(r+".real"))r=r+".real"}catch{}return o("/data/data/com.termux/files/usr/glibc/lib/ld-linux-aarch64.so.1",["--library-path","/data/data/com.termux/files/usr/glibc/lib",r,...t],{stdio:"inherit",env:e})}return o(r,t,{stdio:"inherit"})}'
OLD_U_NOPRELOAD = 'function u(r,t){if(process.platform==="android"){return o("/data/data/com.termux/files/usr/glibc/lib/ld-linux-aarch64.so.1",["--library-path","/data/data/com.termux/files/usr/glibc/lib",r,...t],{stdio:"inherit"})}return o(r,t,{stdio:"inherit"})}'
OLD_U_PRELOAD = 'function u(r,t){if(process.platform==="android"){const e={...process.env};delete e.LD_PRELOAD;return o("/data/data/com.termux/files/usr/glibc/lib/ld-linux-aarch64.so.1",["--library-path","/data/data/com.termux/files/usr/glibc/lib",r,...t],{stdio:"inherit",env:e})}return o(r,t,{stdio:"inherit"})}'
if ',n=u(r,process.argv.slice(2))' not in s:
    s = s.replace(',n=o(r,process.argv.slice(2),{stdio:"inherit"})', ',n=u(r,process.argv.slice(2))')
if OLD_U_NOPRELOAD in s:
    s = s.replace(OLD_U_NOPRELOAD, NEW_U)
elif OLD_U_PRELOAD in s:
    s = s.replace(OLD_U_PRELOAD, NEW_U)
elif 'function u(r,t)' not in s:
    s = s.replace('function s(t,r){', NEW_U + 'function s(t,r){')
if 'process.platform==="android")return["linux"]' not in s:
    s = s.replace('function c(){return process.platform==="linux"', 'function c(){if(process.platform==="android")return["linux"];return process.platform==="linux"')
open(p, 'w').write(s)
PY
        fi
        # Fix shebang for Termux (upstream ships #!/usr/bin/env node)
        [[ -f "$loaderFile" ]] && termux-fix-shebang "$loaderFile"
        # Fix 3: self-healing bash-wrapper vs ELF replica + smoke test
        # Symptom: `copilot` -> ".../copilot-linux-arm64/copilot: invalid ELF header".
        # Cause: npm-loader.js ran `ld-linux ... <r>` where <r> is the
        # bash `.../copilot` wrapper (not ELF); ld.so only loads `copilot.real` (ELF aarch64).
        # Recovery steps (for manual replica when needed):
        #   1) `copilot 2>&1` to get the error.
        #   2) `file .../copilot-linux-arm64/copilot*` -> wrapper=bash script, .real=ELF.
        #   3) `grep -n "android\|LD_PRELOAD\|\.real" npm-loader.js` -> must show all 3.
        #   4) `ld-linux ... copilot.real --version` must return OK; `copilot --version` must return OK.
        platDir="${PREFIX}/lib/node_modules/@github/copilot-linux-arm64"
        if [[ -f "$platDir/copilot.real" && -f "$platDir/copilot" ]]; then
            # wrapper must exist, be executable and delegate to copilot.real via glibc loader
            if ! grep -q 'copilot.real' "$platDir/copilot" 2>/dev/null; then
                printf '#!/data/data/com.termux/files/usr/bin/bash\nexec /data/data/com.termux/files/usr/glibc/lib/ld-linux-aarch64.so.1 "$(dirname "$0")/copilot.real" "$@"\n' > "$platDir/copilot"
            fi
            chmod +x "$platDir/copilot" "$platDir/copilot.real" 2>>"$LOGFILE"
        fi
        if copilot --version >>"$LOGFILE" 2>&1; then
            echo "[✔] copilot smoke test OK ($(copilot --version 2>/dev/null | head -1))"
        else
            echo "[✘] copilot smoke test FAIL (invalid ELF header?). Check $LOGFILE"
            echo " ╰─➤ Steps: file $platDir/copilot* ; grep -n 'LD_PRELOAD\|\\.real' $loaderFile"
        fi
        echo "[✔] copilot android->linux fix applied (glibc loader + copilot.real)"
        ;;

    @testsprite/testsprite-mcp)
        indexFile="${PREFIX}/lib/node_modules/@testsprite/testsprite-mcp/dist/index.js"
        termux-fix-shebang "$indexFile"
        echo "[💡] TestSprite MCP server installed correctly"
        echo " ╰─➤ Get an API key at https://www.testsprite.com/dashboard/settings/apikey"
        echo "[💡] Configure your API key (it will be stored as APIKEY_testsprite)"
        echo " ╰─➤ i-Haklab setapikey"
        echo "[💡] Then register the MCP server in your AI-agent with the API_KEY env var"
        echo " ╰─➤ API_KEY=\$APIKEY_testsprite node $indexFile"
        ;;

    zcode-app-cli)
        entryFile="${PREFIX}/lib/node_modules/zcode-app-cli/bin/zcode.js"
        # Fix shebang for Termux (upstream ships #!/usr/bin/env node)
        [[ -f "$entryFile" ]] && termux-fix-shebang "$entryFile"
        # zcode-cli 0.17.x creates setting.json with tmp+link(). Android/F2FS
        # rejects hardlinks with EACCES, so use rename() for the atomic install.
        if [[ -f "$entryFile" ]] && grep -q 'await link(temporaryPath, configPath);' "$entryFile"; then
            sed -i 's/await link(temporaryPath, configPath);/await rename(temporaryPath, configPath);/' "$entryFile"
            echo "[✔] zcode-cli config creation patched for Android (link -> rename)"
        fi
        # Avoid collision with the zcode desktop wrapper ($PREFIX/bin/zcode):
        # the npm CLI always lives as zcode-cli, desktop keeps zcode.
        if [[ -e "${PREFIX}/bin/zcode" ]] && [[ "$(readlink "${PREFIX}/bin/zcode" 2>/dev/null)" == *zcode-app-cli* ]]; then
            mv -f "${PREFIX}/bin/zcode" "${PREFIX}/bin/zcode-cli"
            echo "[✔] npm bin renamed to zcode-cli (zcode desktop untouched)"
        elif [[ ! -e "${PREFIX}/bin/zcode-cli" && -f "$entryFile" ]]; then
            ln -sf "../lib/node_modules/zcode-app-cli/bin/zcode.js" "${PREFIX}/bin/zcode-cli"
            echo "[✔] zcode-cli link created"
        fi
        # Pre-seed config: Android blocks hardlinks (EACCES) and the launcher
        # creates config.json via tmp+link(), so first run would crash.
        if [[ ! -f "${HOME}/.zcode/cli/config.json" ]]; then
            mkdir -p "${HOME}/.zcode/cli"
            cp "${PREFIX}/lib/node_modules/zcode-app-cli/config.example.json" \
                "${HOME}/.zcode/cli/config.json" 2>/dev/null && \
                chmod 600 "${HOME}/.zcode/cli/config.json" && \
                echo "[✔] Seeded ~/.zcode/cli/config.json from defaults"
        fi
        # Hoist options.apiKey -> top-level apiKey: the launcher preflight reads
        # provider.<id>.options.apiKey but the runtime signer only reads the
        # top-level apiKey (schema Nje). Key in options alone passes `login`
        # checks yet fails at signing ("must contain one separator").
        if [[ -f "${HOME}/.zcode/cli/config.json" ]]; then
            python3 - "${HOME}/.zcode/cli/config.json" <<'PY' 2>/dev/null && echo "[✔] apiKey placement verified (top-level)"
import json, sys
p = sys.argv[1]
d = json.load(open(p))
fixed = []
for pid, prov in (d.get('provider') or {}).items():
    if not isinstance(prov, dict):
        continue
    key = prov.get('options', {}).get('apiKey') if isinstance(prov.get('options'), dict) else None
    if key and not prov.get('apiKey'):
        prov['apiKey'] = key
        fixed.append(pid)
if fixed:
    json.dump(d, open(p, 'w'), indent=2)
    print('[✔] Hoisted options.apiKey to top-level for: %s' % ','.join(fixed))
PY
            chmod 600 "${HOME}/.zcode/cli/config.json" 2>/dev/null
        fi
        # Inject APIKEY_zcode (from `i-Haklab setapikey` -> zcode) into the CLI
        # config when no key is configured yet. Never overwrites an existing key.
        zcode_key="$(grep '^export APIKEY_zcode=' "${HOME}/.local/etc/i-Haklab/variables" 2>/dev/null | head -1 | cut -d'"' -f2)"
        if [[ -n "$zcode_key" && -f "${HOME}/.zcode/cli/config.json" ]]; then
            python3 - "${HOME}/.zcode/cli/config.json" "$zcode_key" <<'PY' 2>/dev/null
import json, sys
p, key = sys.argv[1], sys.argv[2]
d = json.load(open(p))
z = d.setdefault('provider', {}).setdefault('zai', {})
if not z.get('apiKey'):
    z['apiKey'] = key
    if isinstance(z.get('options'), dict):
        z['options']['apiKey'] = key
    json.dump(d, open(p, 'w'), indent=2)
    print('[✔] Injected APIKEY_zcode into ~/.zcode/cli/config.json')
else:
    print('[✔] CLI config already has an API key (kept)')
PY
            chmod 600 "${HOME}/.zcode/cli/config.json" 2>/dev/null
            unset zcode_key
        fi
        # Quota probe: a micro headless prompt classifies the account state.
        # Costs one tiny turn ONLY when quota exists; on [1113]/401 it is free.
        if command -v zcode-cli >/dev/null 2>&1 && command -v timeout >/dev/null 2>&1; then
            echo "[→] Probing Z.AI quota (micro-prompt, timeout 120s)..."
            probe_out="$(timeout 120 zcode-cli --prompt "reply only: OK" --no-browser 2>&1 | head -n 12)"
            if echo "$probe_out" | grep -q "1113\|Insufficient balance"; then
                echo "[⚠] Valid key but OUT OF CREDIT (Coding Plan is paid, no free tier)."
                echo " ╰─➤ Top-up/billing: https://z.ai/manage-apikey/billing"
                echo " ╰─➤ Or try the free BigModel trial:"
                echo "     1) key at https://open.bigmodel.cn/usercenter/apikeys"
                echo "     2) i-Haklab setapikey → bigmodel"
                echo "     3) zcode-cli → /login → BigModel Coding Plan API Key"
            elif echo "$probe_out" | grep -qi "401\|unauthorized\|invalid.*key\|key.*invalid\|authentication"; then
                echo "[⚠] The key was REJECTED. Regenerate it here:"
                echo " ╰─➤ https://z.ai/manage-apikey  →  i-Haklab setapikey → zcode"
            elif echo "$probe_out" | grep -q "Model access is not configured"; then
                echo "[💡] No API key configured. Get one and save it:"
                echo " ╰─➤ Z.AI: https://z.ai/manage-apikey  |  BigModel trial: https://open.bigmodel.cn/usercenter/apikeys"
                echo " ╰─➤ i-Haklab setapikey → zcode (or bigmodel)"
            elif echo "$probe_out" | grep -q "separator\|signing"; then
                echo "[⚠] Local signing failure. Reinstall the package to re-apply the fix."
            else
                echo "[✔] Z.AI answers with your key. All set:"
                echo " ╰─➤ zcode-cli  (TUI)  |  zcode-cli --prompt \"...\" --no-browser"
            fi
            unset probe_out
        fi
        echo "[💡] ZCode CLI installed as zcode-cli (desktop keeps zcode)"
        echo " ╰─➤ zcode-cli --version"
        echo "[💡] Browser OAuth login is macOS-only; on Termux use the API key path"
        echo " ╰─➤ run 'zcode-cli', then /login → Z.AI Coding Plan API Key"
        echo "[💡] Headless without browser automation"
        echo " ╰─➤ zcode-cli --prompt \"...\" --no-browser"
        echo "[💡] Optional native plugins (cua/sharp) are linux-x64 only, core TUI unaffected"
        ;;

    localtunnel)
        mkdir -p ${PREFIX}/lib/node_modules/localtunnel/node_modules/openurl
        curl -fsSL ${iHDB}/.local/etc/localtunnel/openurl.js -o \
            ${PREFIX}/lib/node_modules/localtunnel/node_modules/openurl/openurl.js
        ;;

    mariadb)
        user="root"
        pass="$user"
        pkill mariadbd 2>/dev/null
        mariadbd-safe --skip-grant-tables &
        sleep 5 
        mariadb -u $user -e "FLUSH PRIVILEGES;ALTER USER '$user'@'localhost' IDENTIFIED BY '$user';UPDATE mysql.user SET plugin='mysql_native_password' WHERE User='$user';FLUSH PRIVILEGES;"
        pkill mariadbd 2>/dev/null
        mariadbd-safe &
        sleep 5
        chk_dbuser_exist=$(mariadb -u $user -p$pass -e "use mysql;SELECT user FROM user;" | grep $user|head -n1)
        if [[ $chk_dbuser_exist != $user ]]; then 
            mariadb-secure-installation
            mariadb-install-db 
        fi
        mariadb-upgrade
        ;;

    mvt)
        v=$(python --version|grep -oE '([0-9]{1}\.)[0-9]{1,2}')
        yes|"$PREFIX/bin/apt" install python-cryptography python-pycryptodomex >/dev/null 2>$LOGFILE
        # Define the paths of the files to patch
        BASE_PY_PATH="${PREFIX}/lib/python$v/site-packages/mvt/android/modules/adb/base.py"
        ADB_DEVICE_PY_PATH="${PREFIX}/lib/python$v/site-packages/adb_shell/adb_device.py"
        # --- Patch 1: Fix IndentationError in base.py ---
        curl -fsSL "$iHDB/.local/etc/mvt/base.py" -o $BASE_PY_PATH
        # --- Patch 2: Fix USB import exception handling in adb_device.py ---
        sed -i "s/except (ImportError, OSError):/except (ImportError, OSError, Exception):/" "$ADB_DEVICE_PY_PATH"
        ;;

    n8n)
        echo """function n8n
    export DB_TYPE=sqlite 
    export DB_SQLITE_DATABASE=\$HOME/.n8n/n8n.sqlite

    if ls \$HOME/.pm2/dump.pm2 &> /dev/null 
        echo -e \"\\e[32m[TIP]\\e[0m Run \\e[32m'pm2 resurrect'\\e[0m to restore previous n8n processes.\" 
    end

    echo -e \"\\e[33m[TIP]\\e[0m Run \\e[33m'pm2 --help'\\e[0m to set up pm2 to start on boot.\" 
    echo -e \"\\e[33m[TIP]\\e[0m Run \\e[33m'n8n --help'\\e[0m to see all n8n options.\"
    echo -e \"\\e[33m[TIP]\\e[0m Run \\e[33m'i-Haklab about n8n'\\e[0m for more details.\" 
    \$PREFIX/bin/n8n \$argv
end""" > ${HOME}/.config/fish/functions/n8n.fish
        chmod +x ${HOME}/.config/fish/functions/n8n.fish
        ;;

    obs-studio)
        # Apply the i-HakLab OBS camera scenes to the active collection.
        # OBS keeps the collection in memory while running, so never write it
        # under a live instance.
        if pgrep -x obs >/dev/null 2>&1; then
            echo "[!] Close OBS before applying the camera scenes."
            echo "[i] Then run: pkg2conf obs-studio"
        elif ! command -v python3 >/dev/null 2>&1; then
            echo "[!] python3 is required to merge the OBS scenes."
        else
            python3 - "$HOME" <<'PY' || echo "[!] Could not merge the OBS scenes."
import json
import os
import shutil
import sys
import time
import uuid
from pathlib import Path

home = Path(sys.argv[1])
cfg = home / ".config" / "obs-studio"
scenes_dir = cfg / "basic" / "scenes"
user_ini = cfg / "user.ini"


def ini_get(path, section, key, default=None):
    current = None
    try:
        lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
        return default
    for raw in lines:
        line = raw.strip()
        if line.startswith("[") and line.endswith("]"):
            current = line[1:-1]
        elif current == section and "=" in line:
            name, value = line.split("=", 1)
            if name.strip() == key:
                return value.strip()
    return default


profile_dir = ini_get(user_ini, "Basic", "ProfileDir", "Termux") or "Termux"
profile_ini = cfg / "basic" / "profiles" / profile_dir / "basic.ini"
try:
    base_cx = int(ini_get(profile_ini, "Video", "BaseCX", "1920") or 1920)
    base_cy = int(ini_get(profile_ini, "Video", "BaseCY", "1080") or 1080)
except ValueError:
    base_cx, base_cy = 1920, 1080

collection = ini_get(user_ini, "Basic", "SceneCollectionFile", "Untitled.json")
collection = collection or "Untitled.json"
scene_path = Path(collection)
if not scene_path.is_absolute():
    scene_path = scenes_dir / scene_path

usb_source = "Cámara USB (MJPEG)"
phone_source = "Cámara Teléfono (MJPEG)"
usb_scene = "Cámara USB"
back_scene = "Cámara Trasera"
front_scene = "Cámara Frontal"
combined_scene = "USB + Teléfono"
camera_scenes = [usb_scene, back_scene, front_scene, combined_scene]

ns = uuid.UUID("6c69626f-6273-4c00-9d88-c5136d61696e")
source_uuid = {
    usb_source: str(uuid.uuid5(ns, "i-haklab/obs/usb-source")),
    phone_source: str(uuid.uuid5(ns, "i-haklab/obs/phone-source")),
}


def source_template(name, url):
    return {
        "prev_ver": 553648129,
        "name": name,
        "uuid": source_uuid[name],
        "id": "ffmpeg_source",
        "versioned_id": "ffmpeg_source",
        "settings": {
            "input": url,
            "input_format": "mpjpeg",
            "close_when_inactive": True,
            "hw_decode": False,
            "is_local_file": False,
            "looping": False,
            "clear_on_media_end": False,
            "restart_on_activate": False,
            "buffering_mb": 0,
            "speed_percent": 100,
        },
        "mixers": 0,
        "sync": 0,
        "flags": 0,
        "volume": 1.0,
        "balance": 0.5,
        "enabled": True,
        "muted": True,
        "push-to-mute": False,
        "push-to-mute-delay": 0,
        "push-to-talk": False,
        "push-to-talk-delay": 0,
        "hotkeys": {
            "libobs.mute": [],
            "libobs.unmute": [],
            "libobs.monitor-on": [],
            "libobs.monitor-off": [],
            "libobs.push-to-mute": [],
            "libobs.push-to-talk": [],
            "MediaSource.Restart": [],
            "MediaSource.Play": [],
            "MediaSource.Pause": [],
            "MediaSource.Stop": [],
        },
        "deinterlace_mode": 0,
        "deinterlace_field_order": 0,
        "monitoring_type": 0,
        "monitoring_enabled": False,
        "private_settings": {},
    }


def fullscreen_item(source_name, item_id):
    sx = base_cx / 1280.0
    sy = base_cy / 720.0
    return {
        "name": source_name,
        "source_uuid": source_uuid[source_name],
        "visible": True,
        "locked": False,
        "rot": 0.0,
        "scale_ref": {"x": float(base_cx), "y": float(base_cy)},
        "align": 0,
        "bounds_type": 0,
        "bounds_align": 0,
        "bounds_crop": False,
        "crop_left": 0,
        "crop_top": 0,
        "crop_right": 0,
        "crop_bottom": 0,
        "id": item_id,
        "group_item_backup": False,
        "pos": {"x": base_cx / 2.0, "y": base_cy / 2.0},
        "pos_rel": {"x": 0.0, "y": 0.0},
        "scale": {"x": sx, "y": sy},
        "scale_rel": {"x": sx, "y": sy},
        "bounds": {"x": 0.0, "y": 0.0},
        "bounds_rel": {"x": 0.0, "y": 0.0},
        "scale_filter": "disable",
        "blend_method": "default",
        "blend_type": "normal",
        "show_transition": {"duration": 300},
        "hide_transition": {"duration": 300},
        "private_settings": {},
    }


def pip_item(source_name, item_id):
    pip_w = base_cx * 0.25
    pip_h = pip_w * 720.0 / 1280.0
    margin = 40.0
    center_x = base_cx - margin - pip_w / 2.0
    center_y = base_cy - margin - pip_h / 2.0
    scale = pip_w / 1280.0
    pos_rel_x = (center_x - base_cx / 2.0) / (base_cy / 2.0)
    pos_rel_y = (center_y - base_cy / 2.0) / (base_cy / 2.0)
    return {
        "name": source_name,
        "source_uuid": source_uuid[source_name],
        "visible": True,
        "locked": False,
        "rot": 0.0,
        "scale_ref": {"x": float(base_cx), "y": float(base_cy)},
        "align": 0,
        "bounds_type": 0,
        "bounds_align": 0,
        "bounds_crop": False,
        "crop_left": 0,
        "crop_top": 0,
        "crop_right": 0,
        "crop_bottom": 0,
        "id": item_id,
        "group_item_backup": False,
        "pos": {"x": center_x, "y": center_y},
        "pos_rel": {"x": pos_rel_x, "y": pos_rel_y},
        "scale": {"x": scale, "y": scale},
        "scale_rel": {"x": scale, "y": scale},
        "bounds": {"x": 0.0, "y": 0.0},
        "bounds_rel": {"x": 0.0, "y": 0.0},
        "scale_filter": "disable",
        "blend_method": "default",
        "blend_type": "normal",
        "show_transition": {"duration": 300},
        "hide_transition": {"duration": 300},
        "private_settings": {},
    }


def scene_template(name, items):
    max_id = max((item["id"] for item in items), default=0)
    hotkeys = {"OBSBasic.SelectScene": []}
    for item in items:
        hotkeys[f"libobs.show_scene_item.{item['id']}"] = []
        hotkeys[f"libobs.hide_scene_item.{item['id']}"] = []
    return {
        "prev_ver": 553648129,
        "name": name,
        "uuid": str(uuid.uuid5(ns, "i-haklab/obs/scene/" + name)),
        "id": "scene",
        "versioned_id": "scene",
        "settings": {
            "id_counter": max_id + 1,
            "custom_size": False,
            "items": items,
        },
        "mixers": 0,
        "sync": 0,
        "flags": 0,
        "volume": 1.0,
        "balance": 0.5,
        "enabled": True,
        "muted": False,
        "push-to-mute": False,
        "push-to-mute-delay": 0,
        "push-to-talk": False,
        "push-to-talk-delay": 0,
        "hotkeys": hotkeys,
        "deinterlace_mode": 0,
        "deinterlace_field_order": 0,
        "monitoring_type": 0,
        "monitoring_enabled": False,
        "canvas_uuid": "6c69626f-6273-4c00-9d88-c5136d61696e",
        "private_settings": {},
    }


new_collection = {
    "name": scene_path.stem,
    "sources": [],
    "groups": [],
    "scene_order": [],
    "current_scene": usb_scene,
    "current_program_scene": usb_scene,
    "canvases": [],
    "current_transition": "Fade",
    "transition_duration": 300,
    "transitions": [],
    "quick_transitions": [],
    "saved_projectors": [],
    "preview_locked": False,
    "scaling_enabled": False,
    "scaling_level": -15,
    "scaling_off_x": 0.0,
    "scaling_off_y": 0.0,
    "modules": {},
    "version": 2,
}

if scene_path.exists():
    try:
        data = json.loads(scene_path.read_text(encoding="utf-8"))
    except (OSError, ValueError) as exc:
        print(f"[!] Cannot read {scene_path}: {exc}", file=sys.stderr)
        raise SystemExit(1)
    backup = scene_path.with_name(
        scene_path.name + ".bak.ih-" + time.strftime("%Y%m%d%H%M%S")
    )
    shutil.copy2(scene_path, backup)
    print(f"[i-HakLab] Backup: {backup}")
else:
    data = new_collection
    scene_path.parent.mkdir(parents=True, exist_ok=True)
    if not user_ini.exists():
        cfg.mkdir(parents=True, exist_ok=True)
        user_ini.write_text(
            "[Basic]\n"
            "Profile=Termux\n"
            "ProfileDir=Termux\n"
            "SceneCollection=Untitled\n"
            "SceneCollectionFile=Untitled.json\n",
            encoding="utf-8",
        )

sources = data.setdefault("sources", [])
by_name = {item.get("name"): item for item in sources if isinstance(item, dict)}

for name, url in ((usb_source, "http://127.0.0.1:9000/video"),
                  (phone_source, "http://127.0.0.1:9001/video")):
    existing = by_name.get(name)
    if existing is None:
        obj = source_template(name, url)
        sources.append(obj)
        by_name[name] = obj
        print(f"[i-HakLab] Source '{name}': added")
    elif existing.get("id") != "ffmpeg_source":
        print(f"[!] Source '{name}' already exists with type "
              f"'{existing.get('id')}'; left untouched.")
        old_uuid = existing.get("uuid")
        if old_uuid:
            source_uuid[name] = old_uuid
        else:
            existing["uuid"] = source_uuid[name]
    else:
        settings = existing.setdefault("settings", {})
        settings["input"] = url
        settings["input_format"] = "mpjpeg"
        settings["close_when_inactive"] = True
        existing["muted"] = True
        old_uuid = existing.get("uuid")
        if old_uuid:
            source_uuid[name] = old_uuid
        else:
            existing["uuid"] = source_uuid[name]
        print(f"[i-HakLab] Source '{name}': updated")

existing_scenes = {
    item.get("name") for item in sources
    if isinstance(item, dict) and item.get("id") == "scene"
}
scene_items = {
    usb_scene: [fullscreen_item(usb_source, 1)],
    back_scene: [fullscreen_item(phone_source, 1)],
    front_scene: [fullscreen_item(phone_source, 1)],
    combined_scene: [fullscreen_item(usb_source, 1), pip_item(phone_source, 2)],
}

added_scenes = []
for name in camera_scenes:
    if name in existing_scenes:
        print(f"[i-HakLab] Scene '{name}': already exists, left untouched")
        continue
    sources.append(scene_template(name, scene_items[name]))
    added_scenes.append(name)
    print(f"[i-HakLab] Scene '{name}': added")

order = data.get("scene_order") or []
order_names = {
    (entry.get("name") if isinstance(entry, dict) else entry)
    for entry in order
}
for name in added_scenes:
    if name not in order_names:
        order.append({"name": name})
data["scene_order"] = [
    entry if isinstance(entry, dict) else {"name": entry}
    for entry in order
]

all_scene_names = {
    item.get("name") for item in sources
    if isinstance(item, dict) and item.get("id") == "scene"
}
if data.get("current_scene") not in all_scene_names:
    data["current_scene"] = usb_scene if usb_scene in all_scene_names else next(iter(all_scene_names), "")
if data.get("current_program_scene") not in all_scene_names:
    data["current_program_scene"] = data.get("current_scene", "")

data.setdefault("name", scene_path.stem)
data.setdefault("groups", [])
data.setdefault("canvases", [])
data.setdefault("transitions", [])
data.setdefault("quick_transitions", [])
data.setdefault("saved_projectors", [])
data.setdefault("preview_locked", False)
data.setdefault("scaling_enabled", False)
data.setdefault("scaling_level", -15)
data.setdefault("scaling_off_x", 0.0)
data.setdefault("scaling_off_y", 0.0)
data.setdefault("modules", {})
data.setdefault("version", 2)
data.setdefault("current_transition", "Fade")
data.setdefault("transition_duration", 300)

tmp = scene_path.with_suffix(scene_path.suffix + ".tmp")
tmp.write_text(json.dumps(data, ensure_ascii=False, indent=4) + "\n",
               encoding="utf-8")
os.replace(tmp, scene_path)
print(f"[i-HakLab] OBS collection updated: {scene_path}")
