#!/data/data/com.termux/files/usr/bin/bash
# i-Haklab per-tool pre-install actions (setup before package install)
# Usage: preconf <tool> [npm|pnpm] [action]
IFS=$'\n\t'
trap ctrl_c 2

source $HOME/.local/etc/i-Haklab/variables
source $iHETC/functions

tool="$1"; shift

case "$tool" in
    n8n)
        pm="${1:-npm}"
        for p in nodejs-lts libsqlite sqlite; do
            echo "(_>) Installing $p ..."
            yes|apt install "$p" >/dev/null 2>/dev/null
        done
        for m in pm2 gyp node-gyp; do
            echo "(_>) Installing $m ..."
            "$PREFIX/bin/$pm" install -g "$m"
        done
        echo "(_>) Preparing n8n environment ..."
        mkdir -p "$HOME"/{.n8n,.gyp}
        echo "{'variables':{'android_ndk_path':''}}" > "$HOME/.gyp/include.gypi"
        [[ "$pm" == "pnpm" ]] && "$PREFIX/bin/pnpm" approve-builds -g
        ;;

    obs-studio)
        # OBS camera sources need ffmpeg, adb/scrcpy, and a local libuvc build.
        # Install dependencies before obs-studio itself is unpacked.
        for p in clang cmake make pkg-config git libusb libjpeg-turbo \
                 ffmpeg scrcpy android-tools termux-api mpv python procps \
                 coreutils; do
            if ! dpkg -s "$p" >/dev/null 2>&1 && ! command -v "$p" >/dev/null 2>&1; then
                echo "(_>) Installing $p ..."
                yes | "$PREFIX/bin/apt" install "$p" >/dev/null 2>&1 || true
            fi
        done
        if [[ -x "$HOME/.local/libexec/i-Haklab/build-uvc-cam" ]]; then
            bash "$HOME/.local/libexec/i-Haklab/build-uvc-cam" || \
                echo "(_>) Camera helpers failed to build; run: ~/.local/libexec/i-Haklab/build-uvc-cam"
        else
            echo "(_>) Missing build-uvc-cam (reinstall i-Haklab)"
        fi
        ;;

    open-lovable)
        pm="${1:-npm}"; action="${2:-install}"
        if ls "$HOME/.local/share/open-lovable" &>/dev/null; then
            rm -rf "$HOME/.local/share/open-lovable"
        fi
        git clone --quiet https://github.com/firecrawl/open-lovable.git \
            "$HOME/.local/share/open-lovable"
        cd "$HOME/.local/share/open-lovable"
        corepack enable
        "$PREFIX/bin/$pm" "$action"
        ;;

    ai)
        # Vendored backend (iH-ai-shell.py, stdlib only): no external clones.
        # Migration: remove the old hybrid-cli-ai (repo deleted from GitHub).
        "$PREFIX/bin/pip" uninstall -y hybrid-cli-ai >/dev/null 2>&1
        rm -rf "$HOME/.local/share/hybrid-cli-ai" 2>/dev/null
        mkdir -p "$HOME/.local/share/iH-ai"
        [[ -f "$HOME/.local/libexec/iH-ai-shell.py" ]] || \
            { echo "(_>) Missing iH-ai-shell.py (reinstall i-Haklab)"; exit 1; }
        ;;

    testsprite)
        node_major=$("$PREFIX/bin/node" --version 2>/dev/null | sed 's/^v//;s/\..*//')
        if [[ -z "$node_major" || "$node_major" -lt 22 ]]; then
            echo "(_>) @testsprite/testsprite-mcp needs Node >= 22. Installing nodejs-lts ..."
            yes|apt install nodejs-lts >/dev/null 2>/dev/null
        else
            echo "(_>) Node v$node_major detected, testsprite requirement satisfied."
        fi
        ;;

    zcode-cli)
        node_major=$("$PREFIX/bin/node" --version 2>/dev/null | sed 's/^v//;s/\..*//')
        if [[ -z "$node_major" || "$node_major" -lt 22 ]]; then
            echo "(_>) zcode-app-cli needs Node >= 22. Installing nodejs-lts ..."
            yes|apt install nodejs-lts >/dev/null 2>/dev/null
        else
            echo "(_>) Node v$node_major detected, zcode-cli requirement satisfied."
        fi
        ;;

    *) ;;
esac
exit 0
