#!/usr/bin/env bash
IFS=$'\n\t'
trap ctrl_c 2
source ${HOME}/.local/etc/i-Haklab/variables 
source $iHETC/functions

CHAT_DIR="${HOME}/.chatgpt_chats"
ENGINE="${HOME}/.local/libexec/iH-AI.py"
mkdir -p "$CHAT_DIR"

check_keys() {
    PROVIDERS_OPENAI=() PROVIDERS_DEDICATED=() PROVIDERS_LOCAL=()

    [[ -n "$APIKEY_chatGPT" ]]  && PROVIDERS_OPENAI+=("openai|OpenAI|gpt-4o-mini|APIKEY_chatGPT")
    [[ -n "$APIKEY_deepseek" ]] && PROVIDERS_OPENAI+=("deepseek|DeepSeek|deepseek-chat|APIKEY_deepseek")
    [[ -n "$APIKEY_groq" ]]     && PROVIDERS_OPENAI+=("groq|Groq|llama-3.3-70b-versatile|APIKEY_groq")
    [[ -n "$APIKEY_openrouter" ]] && PROVIDERS_OPENAI+=("openrouter|OpenRouter|openai/gpt-4o-mini|APIKEY_openrouter")
    [[ -n "$APIKEY_togetherai" ]] && PROVIDERS_OPENAI+=("togetherai|Together AI|mistralai/Mixtral-8x7B-Instruct-v0.1|APIKEY_togetherai")
    [[ -n "$APIKEY_mistralAI" ]] && PROVIDERS_OPENAI+=("mistral|Mistral AI|mistral-small-latest|APIKEY_mistralAI")

    gk=""; ck=""
    [[ -n "$APIKEY_Gemini" ]] && gk="$APIKEY_Gemini"
    [[ -z "$gk" ]] && [[ -n "$APIKEY_gemini" ]] && gk="$APIKEY_gemini"
    [[ -n "$gk" ]] && PROVIDERS_DEDICATED+=("gemini|Gemini|gemini-1.5-flash|APIKEY_Gemini|gk")

    [[ -n "$APIKEY_Claude" ]] && ck="$APIKEY_Claude"
    [[ -z "$ck" ]] && [[ -n "$APIKEY_claude" ]] && ck="$APIKEY_claude"
    [[ -n "$ck" ]] && PROVIDERS_DEDICATED+=("anthropic|Claude|claude-3-5-sonnet-20240620|APIKEY_Claude|ck")

    command -v ollama &>/dev/null && PROVIDERS_LOCAL+=("ollama|Ollama|llama3.2")

    local total=$((${#PROVIDERS_OPENAI[@]}+${#PROVIDERS_DEDICATED[@]}+${#PROVIDERS_LOCAL[@]}))
    if [ $total -eq 0 ]; then
        echo -en "$R(>_)$W No API Keys found. Run 'i-Haklab setapikey' first.\n"
        exit 1
    fi
}

select_provider() {
    echo -e "\n$G[?]$W Select AI Provider:"
    local idx=1 ids=() names=() models=() keys=()

    if [ ${#PROVIDERS_OPENAI[@]} -gt 0 ]; then
        echo -e "  $Y[ OpenAI-based ]$W"
        for entry in "${PROVIDERS_OPENAI[@]}"; do
            IFS='|' read -r id name model keyvar <<< "$entry"
            echo "    $idx) $name"
            ids[$idx]="$id"; names[$idx]="$name"; models[$idx]="$model"
            [[ -n "$keyvar" ]] && eval "keys[$idx]=\"\$$keyvar\"" || keys[$idx]=""
            ((idx++))
        done
    fi

    if [ ${#PROVIDERS_DEDICATED[@]} -gt 0 ]; then
        echo -e "  $Y[ Dedicated APIs ]$W"
        for entry in "${PROVIDERS_DEDICATED[@]}"; do
            IFS='|' read -r id name model _ actual_var <<< "$entry"
            echo "    $idx) $name"
            ids[$idx]="$id"; names[$idx]="$name"; models[$idx]="$model"
            eval "keys[$idx]=\"\$$actual_var\""
            ((idx++))
        done
    fi

    if [ ${#PROVIDERS_LOCAL[@]} -gt 0 ]; then
        echo -e "  $Y[ Local ]$W"
        for entry in "${PROVIDERS_LOCAL[@]}"; do
            IFS='|' read -r id name model <<< "$entry"
            echo "    $idx) $name"
            ids[$idx]="$id"; names[$idx]="$name"; models[$idx]="$model"
            keys[$idx]=""
            ((idx++))
        done
    fi

    echo "    0) Exit"
    read -rp "Option: " choice
    [[ "$choice" == "0" ]] && exit 0
    if [[ -z "${ids[$choice]}" ]]; then
        echo -en "$R(>_)$W Invalid option\n"
        select_provider
        return
    fi

    PROVIDER="${ids[$choice]}"
    PROVIDER_NAME="${names[$choice]}"
    MODEL="${models[$choice]}"
    API_KEY="${keys[$choice]}"
}

list_chats() {
    echo -en "\n$Y[ Saved Chats ]$W\n"
    local files=("$CHAT_DIR"/*.json)
    if [ ! -e "${files[0]}" ]; then
        echo "(No saved chats)"
        return 1
    fi
    printf "%-3s %-25s %-20s %s\n" "#" "File" "Date" "Size"
    local i=1
    for file in "${files[@]}"; do
        date=$(date -r "$file" "+%m-%d %H:%M")
        size=$(du -h "$file" | awk '{print $1}')
        name=$(basename "$file")
        printf "%-3s %-25s %-20s %s\n" "$i" "$name" "$date" "$size"
        ((i++))
    done
}

select_chat() {
    list_chats
    echo "N) New chat"
    read -rp "Option: " choice
    if [[ "$choice" =~ ^[0-9]+$ ]]; then
        CHAT_FILE=$(ls "$CHAT_DIR"/*.json 2>/dev/null | sed -n "${choice}p")
    else
        read -rp "Name: " name
        [[ -z "$name" ]] && name="chat_$(date +%s)"
        CHAT_FILE="$CHAT_DIR/${name// /_}.json"
        echo '[{"role":"system","content":"Eres una IA en i-Haklab. Responde en español."}]' > "$CHAT_FILE"
    fi
}

show_help() {
    echo -e "\n$G--- AI Commands ---$W"
    echo -e "/model : Change model ($Y$MODEL$W)"
    echo -e "/clear : Reset chat"
    echo -e "/exit  : Exit"
    echo -e "-------------------"
}

show_models() {
    echo -e "\n$Y[ Models for $PROVIDER_NAME ]$W"
    case $PROVIDER in
        openai)
            echo "1) gpt-4o-mini  2) gpt-4o  3) gpt-4-turbo  4) gpt-3.5-turbo"
            read -rn1 m; echo
            case $m in 2) MODEL="gpt-4o";; 3) MODEL="gpt-4-turbo";; 4) MODEL="gpt-3.5-turbo";; *) MODEL="gpt-4o-mini";; esac ;;
        deepseek)
            echo "1) deepseek-chat  2) deepseek-reasoner"
            read -rn1 m; echo
            [[ $m == 2 ]] && MODEL="deepseek-reasoner" || MODEL="deepseek-chat" ;;
        groq)
            echo "1) llama-3.3-70b-versatile  2) llama-3.1-8b-instant  3) mixtral-8x7b-32768  4) gemma2-9b-it"
            read -rn1 m; echo
            case $m in 2) MODEL="llama-3.1-8b-instant";; 3) MODEL="mixtral-8x7b-32768";; 4) MODEL="gemma2-9b-it";; *) MODEL="llama-3.3-70b-versatile";; esac ;;
        openrouter)
            echo "1) openai/gpt-4o-mini  2) anthropic/claude-3.5-sonnet  3) google/gemini-2.0-flash  4) mistralai/mistral-small"
            read -rn1 m; echo
            case $m in 2) MODEL="anthropic/claude-3.5-sonnet";; 3) MODEL="google/gemini-2.0-flash";; 4) MODEL="mistralai/mistral-small";; *) MODEL="openai/gpt-4o-mini";; esac ;;
        togetherai)
            echo "1) mistralai/Mixtral-8x7B-Instruct-v0.1  2) meta-llama/Llama-3-70b-chat-hf  3) deepseek-ai/deepseek-coder-33b-instruct"
            read -rn1 m; echo
            case $m in 2) MODEL="meta-llama/Llama-3-70b-chat-hf";; 3) MODEL="deepseek-ai/deepseek-coder-33b-instruct";; *) MODEL="mistralai/Mixtral-8x7B-Instruct-v0.1";; esac ;;
        mistral)
            echo "1) mistral-small-latest  2) mistral-medium-latest  3) mistral-large-latest"
            read -rn1 m; echo
            case $m in 2) MODEL="mistral-medium-latest";; 3) MODEL="mistral-large-latest";; *) MODEL="mistral-small-latest";; esac ;;
        gemini)
            echo "1) gemini-1.5-flash  2) gemini-1.5-pro  3) gemini-2.0-flash"
            read -rn1 m; echo
            case $m in 2) MODEL="gemini-1.5-pro";; 3) MODEL="gemini-2.0-flash";; *) MODEL="gemini-1.5-flash";; esac ;;
        anthropic)
            echo "1) claude-3-5-sonnet-20240620  2) claude-3-5-haiku-20241022  3) claude-3-opus-20240229"
            read -rn1 m; echo
            case $m in 2) MODEL="claude-3-5-haiku-20241022";; 3) MODEL="claude-3-opus-20240229";; *) MODEL="claude-3-5-sonnet-20240620";; esac ;;
        ollama)
            echo "1) llama3.2  2) llama3.1  3) mistral  4) codellama"
            read -rn1 m; echo
            case $m in 2) MODEL="llama3.1";; 3) MODEL="mistral";; 4) MODEL="codellama";; *) MODEL="llama3.2";; esac ;;
    esac
    echo -e "Model: $Y$MODEL$W"
}

banner
check_keys
select_provider
select_chat

echo -e "\n$G[$PROVIDER_NAME]$W $Y$MODEL$W | $G/help$W for commands"

while true; do
    echo -en "$B(user)@iH$W: "
    read -r prompt
    [[ -z "$prompt" ]] && continue

    case "$prompt" in
        /exit) break ;;
        /help) show_help; continue ;;
        /clear) echo '[{"role":"system","content":"Eres una IA en i-Haklab."}]' > "$CHAT_FILE"; echo -e "$G[+]$W Cleared."; continue ;;
        /model) show_models; continue ;;
    esac

    temp_hist=$(jq --arg role "user" --arg content "$prompt" '. + [{"role":$role,"content":$content}]' "$CHAT_FILE")
    echo "$temp_hist" > "$CHAT_FILE"

    python3 "$ENGINE" "$CHAT_FILE" "$PROVIDER" "$MODEL" "$API_KEY"
done

k-boom
