#!/data/data/com.termux/files/usr/bin/bash
#
echo "[?] Choose a format :"
echo "[-] For audio only press 1"
echo "[-] For video 360p press 2"
echo "[-] For video 480p press 3"
echo "[-] For video 720p press 4"
echo "[-] For video 1080p press 5"
read -p " ╰──➤ " option

outdir=/data/data/com.termux/files/home/storage/shared/Youtube
executable=/data/data/com.termux/files/home/.local/bin/yt-dlp

case "$option" in
    1) args=( -f "bestaudio/best" ) ;;
    2) args=( -f "bv*+ba/b" -S "res:360" ) ;;
    3) args=( -f "bv*+ba/b" -S "res:480" ) ;;
    4) args=( -f "bv*+ba/b" -S "res:720" ) ;;
    5) args=( -f "bv*+ba/b" -S "res:1080" ) ;;
    *) echo "Invalid option"; exit 1 ;;
esac

exec "$executable" -no-mtime --merge-output-format mp4 -o "$outdir/%(title)s.%(ext)s" "${args[@]}" "$1"
